{
  "name": "lottery-result-checker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "prisma generate && astro build",
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "preview:node": "node dist/server/entry.mjs",
    "lighthouse": "npm run build && PORT=3000 node server.mjs & sleep 2 && npx lighthouse http://localhost:3000 --chrome-flags='--headless=new' --view && kill %1",
    "check": "astro check",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "generate-secrets": "node scripts/generate-secrets.mjs",
    "automation:status": "node --env-file=.env scripts/automation-status.mjs",
    "automation:configure": "node --env-file=.env scripts/configure-automation-cron.mjs",
    "import:archive": "vitest run -c vitest.runners.config.ts tests/runners/archive-import.test.ts --testTimeout=5400000",
    "import:repair": "vitest run -c vitest.runners.config.ts tests/runners/archive-repair.test.ts --testTimeout=5400000"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@prisma/client": "^6.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/compression": "^1.8.1",
    "astro": "^7.3.5",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4",
    "@types/deno": "^2.7.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ]
}
