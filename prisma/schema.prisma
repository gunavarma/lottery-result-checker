// Prisma schema for Kerala Lottery Results Platform (Phase 1 & Phase 2 FCM)
// Authoritative Official Data Source: LOTIS (Directorate of Kerala State Lotteries)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lottery {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  code        String   @unique
  description String?
  drawDay     String   // e.g. "Monday", "Tuesday", "Seasonal Bumper"
  drawTime    String   @default("3:00 PM")
  ticketPrice Int      @default(40) // in INR
  active      Boolean  @default(true)
  isBumper    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  draws               Draw[]
  favoriteByUsers     FavoriteLottery[]
  pushSubscriptions   PushSubscriptionLottery[]
  watchedTickets      TicketWatchlist[]

  @@index([slug])
  @@index([code])
}

model Draw {
  id                String         @id @default(cuid())
  lotteryId         String
  drawNumber        String         // e.g. "KN-638", "SS-534", "SK-67"
  drawDate          DateTime       // Official draw date
  drawTime          String         @default("3:00 PM")
  status            String         @default("PUBLISHED") // SCHEDULED, CHECKING, RESULT_PENDING, PUBLISHED, SOURCE_UNAVAILABLE, SYNC_ERROR
  sourceUrl         String         // Official public URL e.g. https://www.lotteryagent.kerala.gov.in/result/public/
  sourceDocumentUrl String?        // Direct official PDF e.g. https://www.lotteryagent.kerala.gov.in/results/<itemId>
  sourceItemId      String?        // LOTIS UUID
  sourceHash        String?        // MD5/SHA256 checksum of document to detect updates
  rawText           String?        // Audit text
  publishedAt       DateTime?
  verifiedAt        DateTime?      // Timestamp when officially certified
  lastCheckedAt     DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  lottery           Lottery        @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  prizes            Prize[]

  @@unique([lotteryId, drawNumber])
  @@unique([lotteryId, drawDate])
  @@index([drawDate])
  @@index([drawNumber])
  @@index([status])
  @@index([status, drawDate])
}

model Prize {
  id             String          @id @default(cuid())
  drawId         String
  category       String          // e.g. "1st Prize", "Consolation Prize", "2nd Prize", "3rd Prize", "4th Prize", etc.
  description    String?         // e.g. "FOR TICKETS ENDING WITH THE FOLLOWING NUMBERS"
  amount         BigInt          // Prize monetary amount in INR
  orderIndex     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  draw           Draw            @relation(fields: [drawId], references: [id], onDelete: Cascade)
  winningNumbers WinningNumber[]

  @@index([drawId])
  @@index([orderIndex])
}

model WinningNumber {
  id            String   @id @default(cuid())
  prizeId       String
  series        String?  // e.g. "PS", "PN", null if ending-only
  number        String   // 6-digit or 4-digit ticket number
  displayNumber String   // e.g. "PS 320327" or "0266"
  location      String?  // Winning agent district/location if declared in official results
  createdAt     DateTime @default(now())

  prize         Prize    @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  @@index([prizeId])
  @@index([number])
  @@index([displayNumber])
}

// Resumable Historical & Automated Import Jobs
model ImportJob {
  id              String    @id @default(cuid())
  jobType         String    // "HISTORICAL_BACKFILL", "REALTIME_SYNC", "NEWS_SYNC"
  status          String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, PAUSED
  totalItems      Int       @default(0)
  processedItems  Int       @default(0)
  successfulItems Int       @default(0)
  failedItems     Int       @default(0)
  lastCursor      String?   // Pagination offset or token
  errorSummary    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([startedAt])
}

model ImportError {
  id               String    @id @default(cuid())
  sourceIdentifier String    // e.g. itemId, drawNumber, url
  errorType        String    // e.g. "PARSE_ERROR", "NETWORK_ERROR", "VALIDATION_ERROR"
  errorMessage     String
  attemptCount     Int       @default(1)
  status           String    @default("PENDING") // PENDING, RESOLVED, IGNORED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([sourceIdentifier])
  @@index([errorType])
  @@index([status])
}

model SyncLog {
  id            String    @id @default(cuid())
  source        String    @default("LOTIS")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String    // SUCCESS, FAILED, RUNNING, NO_NEW_DATA
  recordsFound  Int       @default(0)
  newDrawsCount Int       @default(0)
  errorMessage  String?
  createdAt     DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}

// Automated Real News System Models
model NewsCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  articles    NewsArticle[]

  @@index([slug])
}

model NewsSource {
  id            String        @id @default(cuid())
  name          String        @unique
  domain        String
  baseUrl       String
  feedUrl       String?
  sourceType    String        @default("OFFICIAL") // OFFICIAL, PRESS_RELEASE, VERIFIED_MEDIA
  isActive      Boolean       @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  articles      NewsArticle[]

  @@index([domain])
  @@index([isActive])
}

model NewsArticle {
  id           String        @id @default(cuid())
  sourceId     String?
  categoryId   String?
  title        String
  slug         String        @unique
  subtitle     String?
  excerpt      String
  content      String        @db.Text
  canonicalUrl String?
  sourceName   String        @default("Kerala State Lotteries Official")
  imageUrl     String?
  imageWidth   Int?
  imageHeight  Int?
  imageAlt     String?
  imageHash    String?
  author       String        @default("KeralaDraws Editorial Desk")
  readTime     String        @default("3 min read")
  isFeatured   Boolean       @default(false)
  status       String        @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  viewCount    Int           @default(0)
  publishedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  source       NewsSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  category     NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([categoryId])
}

// Phase 2: Firebase Cloud Messaging (FCM) Web Push Notification Models
model PushSubscription {
  id              String                   @id @default(cuid())
  fcmToken        String                   @unique
  anonymousUserId String?
  status          String                   @default("ACTIVE") // "ACTIVE", "INACTIVE"
  lastUsedAt      DateTime?                @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  lotterySubscriptions PushSubscriptionLottery[]
  deliveries           NotificationDelivery[]

  @@index([status])
  @@index([fcmToken])
}

model PushSubscriptionLottery {
  id                 String           @id @default(cuid())
  pushSubscriptionId String
  lotteryId          String
  createdAt          DateTime         @default(now())

  pushSubscription   PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)
  lottery            Lottery          @relation(fields: [lotteryId], references: [id], onDelete: Cascade)

  @@unique([pushSubscriptionId, lotteryId])
  @@index([lotteryId])
  @@index([pushSubscriptionId])
}

model NotificationDelivery {
  id                 String           @id @default(cuid())
  resultId           String           // Reference to Draw ID
  pushSubscriptionId String
  status             String           @default("PENDING") // "SENT", "FAILED", "PENDING"
  sentAt             DateTime?
  errorMessage       String?
  createdAt          DateTime         @default(now())

  pushSubscription   PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([resultId, pushSubscriptionId])
  @@index([status])
  @@index([createdAt])
}

model FavoriteLottery {
  id              String   @id @default(cuid())
  anonymousUserId String   // Client device unique token/UUID
  lotteryId       String
  createdAt       DateTime @default(now())

  lottery         Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)

  @@unique([anonymousUserId, lotteryId])
  @@index([anonymousUserId])
}

model TicketWatchlist {
  id           String   @id @default(cuid())
  userId       String?  // Anonymous device UUID or registered user ID
  lotteryId    String
  ticketNumber String   // 6-digit number or 4-digit suffix
  series       String?  // Optional series code (e.g. "PS", "PN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lottery      Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)

  @@index([lotteryId])
  @@index([ticketNumber])
  @@index([userId])
}
