{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lottery-result-checker",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "brotli_content_encoding"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bddaa5dd5fc14add9d608f3149939bbc"
    }
  ],
  "vars": {
    "CLOUDFLARE_WORKERS": "1"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "488950d0c37a4a48983449dca4b266d6"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
