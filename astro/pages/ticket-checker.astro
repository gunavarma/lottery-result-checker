---
/**
 * Ticket Checker page (`/ticket-checker`).
 *
 * Provides instant ticket verification and camera barcode/ticket scanning
 * against certified Kerala State Lottery (LOTIS) official results.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { TicketCheckerIsland } from '@/components/island/ticket-checker';
import { constructMetadata, getBreadcrumbSchema, getFAQSchema } from '@/lib/seo';
import { Breadcrumbs } from '@/components/Breadcrumbs';
import { getPreviousResultsInitialData } from '@/astro/lib/previous-results-data';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Ticket Checker', url: '/ticket-checker' },
];

const head = constructMetadata({
  title: 'Kerala Lottery Scanner & Ticket Checker | KeralaDraws',
  description:
    'Scan or enter Kerala lottery tickets and check them against published results. Check one ticket or scan several to see matching prize tiers.',
  path: '/ticket-checker',
  keywords: [
    'Kerala Lottery Scanner',
    'Lottery Result Scanner',
    'Lottery Ticket Scanner',
    'Kerala Lottery Ticket Checker',
    'Kerala Lottery Ticket Check',
    'Check Kerala Lottery Number',
    'KeralaDraws',
  ],
});

// Breadcrumb + FAQ coverage for the query "is my Kerala lottery ticket a winner".
const faqs = [
  {
    question: 'How do I check if my Kerala lottery ticket has won?',
    answer:
      'Select the draw date and enter your ticket number above. KeralaDraws compares it against every prize tier of the official LOTIS certified draw result automatically.',
  },
  {
    question: 'Does KeralaDraws store the ticket numbers I check?',
    answer:
      'Tickets you check are evaluated in memory and not retained as your personal data. Saved tickets remain in your browser storage only.',
  },
  {
    question: 'Can I scan more than one Kerala lottery ticket at once?',
    answer:
      'Yes. Choose Scan with Camera to scan multiple tickets or upload photos. Review the detected numbers and verify them together.',
  },
];

// Pre-load available verified draw dates server-side so the date selector is instant
const initialData = await getPreviousResultsInitialData();
const availableDates = initialData?.availableDates ?? [];
---

<BaseLayout
  head={head}
  locale="en"
  jsonLd={[getBreadcrumbSchema(breadcrumbs), getFAQSchema(faqs)]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-8">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'Ticket Checker' }]}
    />

    <div class="border-b border-[#E2E7E3] pb-6 space-y-3">
      <div class="flex items-center gap-2">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#E9F3EE] text-[#0B3B32] font-tabular border border-[#CDE3D8]"
        >
          <span class="w-2 h-2 rounded-full bg-[#16845B]"></span>
          Official LOTIS Verification
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#17201D] tracking-tight">
        Kerala Lottery Scanner &amp; Ticket Checker
      </h1>
      <p class="text-sm sm:text-base text-[#52605A] max-w-2xl leading-relaxed">
        Verify your ticket numbers directly against official Kerala State Lottery results. Select the draw date or check across all recent published draws.
      </p>
    </div>

    {/* `/ticket-checker?number=…` is the target of the homepage sidebar's plain
        GET form. The number is only prefilled — the comparison runs when the
        visitor submits — so a shared or crawled URL cannot trigger a lookup. */}
    <TicketCheckerIsland
      client:load
      locale="en"
      initialNumber={Astro.url.searchParams.get('number')?.slice(0, 20) ?? undefined}
      availableDates={availableDates}
    />

    <section class="max-w-4xl space-y-4 pt-4 border-t border-[#E2E7E3]" aria-labelledby="scanner-guide-title">
      <div class="space-y-1">
        <h2 id="scanner-guide-title" class="text-lg sm:text-xl font-extrabold text-[#17201D]">
          How to verify your Kerala lottery ticket
        </h2>
        <p class="text-xs sm:text-sm text-[#68736E]">
          Follow these quick steps to check if your ticket matches any published winning numbers:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 pt-1">
        <div class="bg-white border border-[#E2E7E3] rounded-2xl p-4 sm:p-5 space-y-2">
          <div class="w-7 h-7 rounded-lg bg-[#E9F3EE] text-[#0B3B32] font-bold text-xs flex items-center justify-center font-tabular">
            1
          </div>
          <h3 class="font-extrabold text-sm text-[#17201D]">Select Draw Date</h3>
          <p class="text-xs text-[#52605A] leading-relaxed">
            Choose the draw date printed on your ticket, or keep All Recent Draws to check across all published results.
          </p>
        </div>

        <div class="bg-white border border-[#E2E7E3] rounded-2xl p-4 sm:p-5 space-y-2">
          <div class="w-7 h-7 rounded-lg bg-[#E9F3EE] text-[#0B3B32] font-bold text-xs flex items-center justify-center font-tabular">
            2
          </div>
          <h3 class="font-extrabold text-sm text-[#17201D]">Enter or Scan Number</h3>
          <p class="text-xs text-[#52605A] leading-relaxed">
            Enter the 6-digit number or 4-digit ending, or use <strong>Scan with Camera</strong> to detect ticket numbers automatically.
          </p>
        </div>

        <div class="bg-white border border-[#E2E7E3] rounded-2xl p-4 sm:p-5 space-y-2">
          <div class="w-7 h-7 rounded-lg bg-[#E9F3EE] text-[#0B3B32] font-bold text-xs flex items-center justify-center font-tabular">
            3
          </div>
          <h3 class="font-extrabold text-sm text-[#17201D]">Instant Verification</h3>
          <p class="text-xs text-[#52605A] leading-relaxed">
            Click Check Ticket to compare your number against official gazette results and see prize categories and amounts.
          </p>
        </div>
      </div>

      <p class="text-xs text-[#68736E] pt-1">
        Always verify your physical ticket and draw details against the official Kerala State Government gazette result before claiming any prize.
      </p>
    </section>
  </div>
</BaseLayout>
