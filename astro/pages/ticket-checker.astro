---
/**
 * (+ `check-ticket/layout.tsx`
 * for the head copy).
 *
 * The original was a server component that did no data fetching of its own — it
 * only wrapped `<TicketChecker />`. In Astro that means the route markup is real
 * here and the interactive part is a single island, which is what `client:load`
 * expresses.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { TicketCheckerIsland } from '@/components/island/ticket-checker';
import { constructMetadata, getBreadcrumbSchema, getFAQSchema } from '@/lib/seo';
import { Breadcrumbs } from '@/components/Breadcrumbs';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Ticket Checker', url: '/ticket-checker' },
];

const head = constructMetadata({
  title: 'Kerala Lottery Scanner & Ticket Checker | KeralaDraws',
  description:
    'Scan or enter Kerala lottery tickets and check them against published results. Check one ticket or scan several to see matching prize tiers.',
  path: '/ticket-checker',
  keywords: [
    'Kerala Lottery Scanner',
    'Lottery Result Scanner',
    'Lottery Ticket Scanner',
    'Kerala Lottery Ticket Checker',
    'Kerala Lottery Ticket Check',
    'Check Kerala Lottery Number',
    'KeralaDraws',
  ],
});

// Breadcrumb + FAQ coverage for the query "is my Kerala lottery ticket a winner".
const faqs = [
  {
    question: 'How do I check if my Kerala lottery ticket has won?',
    answer:
      'Enter your ticket number above and KeralaDraws compares it against every prize tier of the official LOTIS certified draw result automatically.',
  },
  {
    question: 'Does KeralaDraws store the ticket numbers I check?',
    answer:
      'Tickets you save are stored only in your own browser. Un-saved numbers are used to run the comparison and are not retained as your personal data.',
  },
  {
    question: 'Can I scan more than one Kerala lottery ticket at once?',
    answer:
      'Yes. Choose Scan Tickets to scan with your camera or select ticket images. Review the detected numbers, then check them together against published results.',
  },
];
---

<BaseLayout
  head={head}
  locale="en"
  jsonLd={[getBreadcrumbSchema(breadcrumbs), getFAQSchema(faqs)]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-8">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'Ticket Checker' }]}
    />

    <div class="border-b border-[#E2E7E3] pb-6 space-y-2">
      <span
        class="text-[11px] font-bold text-[#0B3B32] uppercase tracking-wider block font-tabular"
      >
        Instant Verification
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#17201D] tracking-tight">
        Kerala Lottery Scanner &amp; Ticket Checker
      </h1>
      <p class="text-xs sm:text-sm text-[#68736E] max-w-3xl">
        Scan a ticket with your camera, upload a ticket photo, or enter its
        number manually. Check one ticket or scan several against published
        Kerala lottery results.
      </p>
      <p class="text-sm text-[#52605A]">
        Looking for today's winning numbers?
        <a
          class="font-semibold text-[#0B3B32] underline underline-offset-2"
          href="/"
        >
          View the latest Kerala lottery result.
        </a>
      </p>
    </div>

    {/* `/ticket-checker?number=…` is the target of the homepage sidebar's plain
        GET form. The number is only prefilled — the comparison runs when the
        visitor submits — so a shared or crawled URL cannot trigger a lookup. */}
    <TicketCheckerIsland
      client:load
      locale="en"
      initialNumber={Astro.url.searchParams.get('number')?.slice(0, 20) ?? undefined}
    />

    <section class="max-w-3xl space-y-3" aria-labelledby="scanner-guide-title">
      <h2 id="scanner-guide-title" class="text-xl font-extrabold text-[#17201D]">
        How to scan and check a Kerala lottery ticket
      </h2>
      <ol class="list-decimal pl-5 space-y-2 text-sm text-[#52605A]">
        <li>Select the lottery scheme for your ticket.</li>
        <li>Enter its number, or choose <strong>Scan Tickets</strong> to use your camera or select ticket photos. Review the numbers the scanner reads.</li>
        <li>Check the ticket to compare its number with the published prize results.</li>
      </ol>
      <p class="text-sm text-[#68736E]">
        The scanner helps read ticket numbers; check the printed number and draw details against the result before making a claim.
      </p>
      <p class="text-sm">
        <a
          class="font-semibold text-[#0B3B32] underline underline-offset-2"
          href="/guides/how-to-check-kerala-lottery-ticket"
        >
          Read the step-by-step Kerala lottery ticket scanning guide.
        </a>
      </p>
    </section>
  </div>
</BaseLayout>
