---
/**
 * Ported from `app/(en)/kerala-lottery-result/[date]/page.tsx`.
 * Was `export const revalidate = 300`; a gazetted draw is immutable, so it takes
 * the result-page window rather than the live one.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { KeralaLotteryResultDatePageIsland } from '@/components/island/kerala-lottery-result-date-page';
import {
  buildMetadataFromData,
  getHistoricalDrawData,
} from '@/components/pages/KeralaLotteryResultDatePage';
import { REVALIDATE, setRevalidateHeaders } from '../../lib/cache-headers';

// Astro only matches a dynamic route when the segment is present.
const dateStr = Astro.params.date as string;
const data = await getHistoricalDrawData(dateStr);

// Strict anti-soft-404: a date with no gazette-verified draw must not return 200.
if (!data || !data.draws || data.draws.length === 0) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

setRevalidateHeaders(Astro, REVALIDATE.RESULT_PAGE);

// Construct metadata directly from loaded data without re-fetching
const head = buildMetadataFromData(data, dateStr);
---

<BaseLayout head={head} locale="en">
  <KeralaLotteryResultDatePageIsland client:idle locale="en" dateStr={dateStr} data={data} />
</BaseLayout>
