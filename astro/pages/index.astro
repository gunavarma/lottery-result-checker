---
/**
 * English homepage — canonical unprefixed route.
 * Ported from `app/(en)/page.tsx`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { constructMetadata } from '@/lib/seo';
import { REVALIDATE, setRevalidateHeaders } from '../lib/cache-headers';

// Was `export const revalidate = 30` under Next.js ISR.
setRevalidateHeaders(Astro, REVALIDATE.LIVE);

// Title, description and share-card copy are copied verbatim from the Next.js
// homepage's `metadata` export so the port is not an SEO change.
const HOMEPAGE_TITLE = 'Kerala Lottery Result Today — Live Winning Numbers';
const HOMEPAGE_DESCRIPTION =
  'Kerala lottery result today and every past draw. Verified winning numbers, complete prize tables and an instant ticket checker.';

const head = constructMetadata({
  path: '/',
  title: HOMEPAGE_TITLE,
  description: HOMEPAGE_DESCRIPTION,
  openGraphTitle: HOMEPAGE_TITLE,
  openGraphDescription: HOMEPAGE_DESCRIPTION,
});
---

<BaseLayout head={head} locale="en">
  <HomeContent locale="en" />
</BaseLayout>
