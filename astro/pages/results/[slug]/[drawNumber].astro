---
/**
 * Ported from `app/(en)/results/[slug]/[drawNumber]/page.tsx`.
 * Was `export const revalidate = 300` — these permanent result URLs are the main
 * indexed surface, and their content cannot change once gazetted.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PermanentResultPage, { generateMetadata, getDrawResultData } from '@/components/pages/PermanentResultPage';
import { CACHE_TAG, REVALIDATE, setRevalidateHeaders } from '../../../lib/cache-headers';

const slug = Astro.params.slug as string;
const drawNumber = Astro.params.drawNumber as string;

const data = await getDrawResultData(slug, drawNumber);

if (!data || !data.draw) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

// Official permanent URLs are immutable — a day-long CDN window. A provisional
// draw can still be upgraded to OFFICIAL in place, so it keeps the short window
// until the gazette confirms it.
const isOfficial = ((data.draw as any).verificationLevel ?? 'OFFICIAL') === 'OFFICIAL';
setRevalidateHeaders(Astro, isOfficial ? REVALIDATE.HISTORICAL : REVALIDATE.RESULT_PAGE, {
  tags: [CACHE_TAG.lottery(slug), CACHE_TAG.RESULTS],
  ...(isOfficial ? { staleWhileRevalidate: REVALIDATE.HISTORICAL_SWR } : {}),
});

const head = await generateMetadata({ params: Promise.resolve({ slug, drawNumber }) });
---

<BaseLayout head={head} locale="en">
  <PermanentResultPage
    slug={slug}
    drawNumber={drawNumber}
    data={data}
  />
</BaseLayout>
