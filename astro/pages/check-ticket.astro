---
/**
 * Legacy `/check-ticket` alias for the ticket checker.
 *
 * The original read `searchParams` from the page props and rebuilt the query
 * string. Astro's `URL` gives the same thing directly, and `url.search` already
 * carries the leading `?`, so a ticket number passed in the old URL survives the
 * redirect instead of silently landing on an empty checker.
 */
const currentUrl = new URL(Astro.request.url);
return Astro.redirect(`/ticket-checker${currentUrl.search}`, 308);
---
