---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RazorpayCheckoutIsland } from '@/components/island/razorpay-checkout';
import { constructMetadata, getBreadcrumbSchema } from '@/lib/seo';
import { Breadcrumbs } from '@/components/Breadcrumbs';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Checkout', url: '/checkout' },
];

const head = constructMetadata({
  title: 'Secure Checkout | KeralaDraws',
  description: 'Complete your transaction securely via Razorpay standard web checkout.',
  path: '/checkout',
});
---

<BaseLayout head={head} locale="en" jsonLd={[getBreadcrumbSchema(breadcrumbs)]}>
  {/* Razorpay Standard Checkout Script */}
  <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'Checkout' }]}
    />

    <div class="border-b border-[#E2E7E3] pb-6 space-y-2">
      <span class="inline-block text-xs uppercase tracking-wider font-semibold text-[#0B5D45]">
        Payment Gateway Integration
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#10201D] tracking-tight">
        Razorpay Standard Web Checkout
      </h1>
      <p class="text-sm sm:text-base text-[#5F6B66] max-w-2xl">
        Test and verify the end-to-end payment workflow: order creation via backend API,
        standard payment modal popup, and HMAC-SHA256 signature verification.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <div class="md:col-span-2">
        <RazorpayCheckoutIsland client:load />
      </div>

      <div class="bg-[#F4F5F2] rounded-2xl p-6 border border-[#E2E7E3] space-y-4 text-xs text-[#5F6B66]">
        <h2 class="font-bold text-[#10201D] text-sm flex items-center gap-2">
          <span>⚙️</span> Integration Checklist
        </h2>
        <ul class="space-y-2.5">
          <li class="flex items-start gap-2">
            <span class="text-[#0B5D45] font-bold">✓</span>
            <span><strong>POST /api/create-order:</strong> Generates order ID with amount validation (≥ 100 paise).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#0B5D45] font-bold">✓</span>
            <span><strong>Frontend Checkout Modal:</strong> Standard modal initialized with order_id and key_id.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#0B5D45] font-bold">✓</span>
            <span><strong>POST /api/verify-payment:</strong> Verifies signature with HMAC-SHA256 algorithm.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#0B5D45] font-bold">✓</span>
            <span><strong>Error Handling:</strong> Handles modal dismiss, payment failure, and invalid signatures.</span>
          </li>
        </ul>

        <div class="pt-3 border-t border-[#E2E7E3] space-y-1">
          <div class="font-semibold text-[#10201D]">Test Mode Credentials:</div>
          <div class="font-mono text-[11px] text-[#0B5D45] break-all">
            Key ID: rzp_test_TrzFF72uQ7fUHX
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
