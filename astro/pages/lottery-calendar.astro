---
/**
 * Was `force-dynamic`, so it
 * keeps `no-store` semantics.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { LotteryCalendarPageIsland } from '@/components/island/lottery-calendar-page';
import { metadata, getCalendarDraws } from '@/components/pages/LotteryCalendarPage';
import { REVALIDATE, setRevalidateHeaders } from '../lib/cache-headers';

setRevalidateHeaders(Astro, REVALIDATE.CONTENT);

const publishedDraws = await getCalendarDraws();
---

<BaseLayout head={metadata} locale="en">
  <LotteryCalendarPageIsland client:idle={{ timeout: 1000 }} locale="en" publishedDraws={publishedDraws} />
</BaseLayout>
