---
/**
 * Locale mirror of `/kerala-lottery-result-today` (`/ml`, `/ta`, `/hi`).
 *
 * The body is the English route verbatim — same data fetch, same islands, same
 * cache and analytics behaviour — with two deliberate differences: `en` and
 * anything that is not a supported locale is refused with a real 404, and the
 * head is re-derived through `mirrorMetadata()` so the canonical URL, the
 * hreflang alternates and `og:locale` describe the localized page rather than
 * the English one.
 */
/**
 * Was `export const revalidate = 30` under Next.js ISR.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TodayResultPage, { generateMetadata, getTodayResultData } from '@/components/pages/TodayResultPage';
import { REVALIDATE, setRevalidateHeaders } from '../../lib/cache-headers';
import { resultViewEvent } from '@/lib/analytics';
import { isLocale } from '@/lib/i18n/config';
import { mirrorMetadata } from '@/lib/i18n/mirror';
import type { Language } from '@/lib/translations';

setRevalidateHeaders(Astro, REVALIDATE.LIVE);

const enHead = await generateMetadata();
const { isFromToday, draw } = await getTodayResultData();

// `verification_status` is the whole point of this event on the live page: a
// PROVISIONAL draw (aggregator numbers, not yet gazetted) and an OFFICIAL one
// are reported side by side, which is how the two-tier trust model can be
// measured. Reported by the layout's head script; no island is involved.
const analyticsEvents = draw
  ? [
      resultViewEvent({
        lotteryName: draw.lottery.name,
        drawDate: draw.drawDate,
        drawNumber: draw.drawNumber,
        verificationStatus: (draw as { verificationLevel?: string | null }).verificationLevel,
      }),
    ]
  : [];

// Locale wiring. `[locale]` matches any single segment, so an unsupported or
// default-locale prefix has to be refused here rather than by the router.
const locale = Astro.params.locale as Language;
if (!isLocale(locale) || locale === 'en') {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const head = mirrorMetadata(locale, '/kerala-lottery-result-today', enHead);

---

<BaseLayout head={head} locale={locale} analyticsEvents={analyticsEvents}>
  <TodayResultPage isFromToday={isFromToday} draw={draw} />
</BaseLayout>
