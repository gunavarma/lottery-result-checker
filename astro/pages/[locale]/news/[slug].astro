---
/**
 * Locale mirror of `/news/[slug]` (`/ml`, `/ta`, `/hi`).
 *
 * The body is the English route verbatim — same data fetch, same islands, same
 * cache and analytics behaviour — with two deliberate differences: `en` and
 * anything that is not a supported locale is refused with a real 404, and the
 * head is re-derived through `mirrorMetadata()` so the canonical URL, the
 * hreflang alternates and `og:locale` describe the localized page rather than
 * the English one.
 */
/**
 *
 * Two things had to change shape. `params` is a plain object in Astro rather
 * than a promise, so the slug is read directly and passed to the page as a prop.
 * And Astro has no `generateMetadata`, so the exported metadata builder is
 * called here instead — it is unchanged, because `await` on a plain object is a
 * no-op, so passing `{ params: { slug } }` satisfies it exactly as before.
 *
 * An unknown slug rewrites to the shared 404 route with a real 404 status,
 * replacing Next's `notFound()`.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsArticlePage, { generateMetadata } from '@/components/pages/NewsArticlePage';
import { getNewsBySlug } from '@/lib/news';
import { REVALIDATE, setRevalidateHeaders } from '../../../lib/cache-headers';
import { isLocale } from '@/lib/i18n/config';
import { mirrorMetadata } from '@/lib/i18n/mirror';
import type { Language } from '@/lib/translations';

// Astro only matches a dynamic route when the segment is present.
const slug = Astro.params.slug as string;
const article = getNewsBySlug(slug);

if (!article) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

setRevalidateHeaders(Astro, REVALIDATE.CONTENT);

// `generateMetadata` is typed against Next's awaiting `params` object. Wrapping
// the slug in a resolved promise satisfies that type exactly while keeping the
// metadata builder byte-identical to the original.
const enHead = await generateMetadata({ params: Promise.resolve({ slug }) });

// Locale wiring. `[locale]` matches any single segment, so an unsupported or
// default-locale prefix has to be refused here rather than by the router.
const locale = Astro.params.locale as Language;
if (!isLocale(locale) || locale === 'en') {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const head = mirrorMetadata(locale, `/news/${slug}`, enHead);

---

<BaseLayout head={head} locale={locale}>
  <NewsArticlePage slug={slug} />
</BaseLayout>
