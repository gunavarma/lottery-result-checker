---
/**
 * Locale mirror of `/terms` (`/ml`, `/ta`, `/hi`).
 *
 * The body is the English route verbatim — same data fetch, same islands, same
 * cache and analytics behaviour — with two deliberate differences: `en` and
 * anything that is not a supported locale is refused with a real 404, and the
 * head is re-derived through `mirrorMetadata()` so the canonical URL, the
 * hreflang alternates and `og:locale` describe the localized page rather than
 * the English one.
 */
/**
 *
 * The page body is deliberately kept as the original presentational React
 * component and rendered here **without** a `client:*` directive. Astro's React
 * renderer evaluates it to HTML on the server and ships no JavaScript for it, so
 * the two visible differences from Next.js are that the page body no longer
 * hydrates at all and its `metadata` export is passed to `BaseLayout` as the
 * head. Rewriting ~100 lines of legal prose into `.astro` markup would only add
 * transcription risk without changing a single byte of the output.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermsPage, { metadata } from '@/components/pages/TermsPage';
import { isLocale } from '@/lib/i18n/config';
import { mirrorMetadata } from '@/lib/i18n/mirror';
import type { Language } from '@/lib/translations';

// Locale wiring. `[locale]` matches any single segment, so an unsupported or
// default-locale prefix has to be refused here rather than by the router.
const locale = Astro.params.locale as Language;
if (!isLocale(locale) || locale === 'en') {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const head = mirrorMetadata(locale, '/terms', metadata);

---

<BaseLayout head={head} locale={locale}>
  <TermsPage />
</BaseLayout>
