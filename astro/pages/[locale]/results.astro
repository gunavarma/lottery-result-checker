---
/**
 * Locale mirror of `/results` (`/ml`, `/ta`, `/hi`).
 *
 * The body is the English route verbatim — same data fetch, same islands, same
 * cache and analytics behaviour — with two deliberate differences: `en` and
 * anything that is not a supported locale is refused with a real 404, and the
 * head is re-derived through `mirrorMetadata()` so the canonical URL, the
 * hreflang alternates and `og:locale` describe the localized page rather than
 * the English one.
 */
/**
 *
 * The page body had no interactive children, so it stays as one presentational
 * React component and Astro renders it to HTML with no hydration. Only the data
 * fetch moved: Astro has no async components, so `getResultsHubData()` runs here
 * in the frontmatter and its result is handed to the component as props.
 *
 * Was `force-dynamic` in Next.js — an uncached HTML render on every hit while
 * the data underneath it is already cached for 60s. That is exactly what a CDN
 * cache window expresses, so this now uses `REVALIDATE.CONTENT` instead.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ResultsHubPage, metadata, getResultsHubData } from '@/components/pages/ResultsHub';
import { REVALIDATE, setRevalidateHeaders } from '../../lib/cache-headers';
import { isLocale } from '@/lib/i18n/config';
import { mirrorMetadata } from '@/lib/i18n/mirror';
import type { Language } from '@/lib/translations';

setRevalidateHeaders(Astro, REVALIDATE.CONTENT);

const { latestDraws, lotteries } = await getResultsHubData();

// Locale wiring. `[locale]` matches any single segment, so an unsupported or
// default-locale prefix has to be refused here rather than by the router.
const locale = Astro.params.locale as Language;
if (!isLocale(locale) || locale === 'en') {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const head = mirrorMetadata(locale, '/results', metadata);

---

<BaseLayout head={head} locale={locale}>
  <ResultsHubPage latestDraws={latestDraws} lotteries={lotteries} />
</BaseLayout>
