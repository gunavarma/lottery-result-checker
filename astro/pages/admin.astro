---
/**
 * Operator panel for manually entering lottery results.
 *
 * Private tool: it lives in `AdminLayout` (no public navigation, no analytics),
 * sends `no-store`, and is reached only through the session gate in
 * `astro/middleware.ts`. The page itself never decides whether the caller is
 * allowed in — it reads the configured username purely to label the header.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import { AdminPageIsland } from '@/components/island/admin-page';
import { setNoStoreHeaders } from '../lib/cache-headers';
import { getAdminConfig } from '@/lib/admin/session';

setNoStoreHeaders(Astro);

const config = getAdminConfig();
---

<AdminLayout title="Admin panel — KeralaDraws" subtitle="Result publishing">
  <Fragment slot="actions">
    <div class="flex items-center gap-3 text-[11px]">
      <span class="hidden text-white/60 sm:inline">
        Signed in as <strong class="font-bold text-white">{config.username}</strong>
      </span>
      <form method="POST" action="/api/admin/logout">
        <button
          type="submit"
          class="rounded-lg border border-white/20 px-2.5 py-1.5 font-bold text-white transition-colors hover:bg-white/10"
        >
          Sign out
        </button>
      </form>
    </div>
  </Fragment>

  <AdminPageIsland client:load locale="en" />
</AdminLayout>
