---
/**
 * The headline result card: which draw, when it was published, and — when the
 * draw stores them — the series codes a ticket must carry to win.
 *
 * This is the block the visitor (and a crawler) sees first, so it is rendered
 * entirely on the server from the newest *published* draw. It carries the draw
 * name, number, date, weekday and update time as text, and it links to both the
 * draw page and the date archive for that draw, which is what keeps the two
 * historical routes reachable from the homepage without any click-through.
 *
 * "Latest published" rather than "today": after 3:00 PM the newest published
 * draw is today's; before it, this card is yesterday's, and saying so is more
 * honest than showing an empty shell for a draw that has not happened yet.
 */
import { ExternalLink, FileText, ArrowRight, Link2 } from 'lucide-react';
import {
  drawResultHref,
  dateArchiveHref,
  formatDdMmYyyy,
  formatIstTimestamp,
  seriesCodes,
  type DrawReference,
  type Prize,
} from './home-format';
import { createTranslator, localizedWeekday } from '@/lib/i18n/server';
import type { Language } from '@/lib/translations';

interface Props {
  /** Locale of the page being rendered. */
  locale?: Language;
  draw: (DrawReference & {
    id?: string;
    drawTime?: string | null;
    status?: string | null;
    verificationLevel?: string | null;
    sourceDocumentUrl?: string | null;
    publishedAt?: string | null;
    verifiedAt?: string | null;
    updatedAt?: string | null;
    prizes?: Prize[] | null;
  }) | null;
  /** True when the newest published draw is today's. */
  isToday?: boolean;
}

const { locale = 'en', draw, isToday = false } = Astro.props;
const { t, tf } = createTranslator(locale);

const resultHref = drawResultHref(draw);
const archiveHref = dateArchiveHref(draw?.drawDate);
const codes = seriesCodes(draw?.prizes);
const isProvisional = (draw?.verificationLevel ?? 'OFFICIAL') === 'PROVISIONAL';
const updatedAt = formatIstTimestamp(draw?.updatedAt ?? draw?.verifiedAt ?? draw?.publishedAt);

const metaBoxes = [
  { label: t('home.latest.meta_draw_number'), value: draw?.drawNumber ?? '—' },
  { label: t('home.latest.meta_draw_date'), value: formatDdMmYyyy(draw?.drawDate) },
  {
    label: t('home.latest.meta_draw_day'),
    value: localizedWeekday(draw?.drawDate, locale) || draw?.lottery?.code || '—',
  },
  {
    label: t('home.latest.meta_update_time'),
    value: draw?.drawTime || updatedAt?.replace(/^.*?,\s*/, '') || '3:00 PM',
  },
];
---

{
  draw ? (
    <section
      id="latest-result"
      class="overflow-hidden rounded-xl border border-[#0A4E3A]/30 bg-gradient-to-br from-[#0F7B4F] via-[#0B5D45] to-[#0A4A38] text-white shadow-sm"
    >
      <div class="space-y-4 px-4 py-4 sm:px-6 sm:py-5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded bg-black/25 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-[#9EE6BE] font-tabular">
            {isToday ? t('home.latest.badge_today') : t('home.latest.badge_latest')}
          </span>
          <span
            class={`rounded px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider font-tabular ${
              isProvisional ? 'bg-[#C59B27]/25 text-[#F5DFA0]' : 'bg-white/10 text-white/80'
            }`}
          >
            {isProvisional ? t('home.latest.provisional') : t('home.latest.official')}
          </span>
        </div>

        <h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">
          {tf('home.latest.heading', {
            name: draw.lottery?.name ?? '',
            draw: draw.drawNumber ?? '',
          })}
        </h2>

        <dl class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          {metaBoxes.map((box) => (
            <div class="rounded-lg border border-white/10 bg-white/10 px-3 py-2">
              <dt class="text-[9px] font-bold uppercase tracking-wider text-white/60 font-tabular">
                {box.label}
              </dt>
              <dd class="mt-0.5 text-sm font-bold font-tabular">{box.value}</dd>
            </div>
          ))}
        </dl>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] font-semibold">
          {resultHref && (
            <a
              href={resultHref}
              class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-1.5 text-[#0B3B32] transition-colors hover:bg-[#E9F3EE]"
            >
              <span>{t('home.latest.view_full')}</span>
              <ArrowRight className="h-3.5 w-3.5" />
            </a>
          )}
          {archiveHref && (
            <a
              href={archiveHref}
              class="inline-flex items-center gap-1.5 text-white/85 hover:text-white hover:underline"
            >
              <span>{tf('home.latest.all_draws', { date: formatDdMmYyyy(draw.drawDate) })}</span>
            </a>
          )}
          {draw.sourceDocumentUrl && (
            <a
              href={draw.sourceDocumentUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-white/85 hover:text-white hover:underline"
            >
              <FileText className="h-3.5 w-3.5" />
              <span>{t('home.latest.gazette_pdf')}</span>
              <ExternalLink className="h-3 w-3" />
            </a>
          )}
          {resultHref && (
            <a
              href={`${resultHref}#prize-chart`}
              class="ml-auto inline-flex items-center gap-1.5 text-white/70 hover:text-white hover:underline"
              title={t('home.latest.permalink')}
            >
              <Link2 className="h-3.5 w-3.5" />
              <span>{t('home.latest.permalink')}</span>
            </a>
          )}
        </div>

        {updatedAt && (
          <p class="text-[10px] text-white/60">
            {tf('home.latest.updated', { timestamp: updatedAt })}
          </p>
        )}
      </div>

      {
        codes.length > 0 && (
          <div class="border-t border-white/10 bg-black/15 px-4 py-3 sm:px-6">
            <p class="text-[10px] font-bold uppercase tracking-wider text-white/60 font-tabular">
              {t('home.latest.series_codes')}
            </p>
            <ul class="mt-1.5 flex flex-wrap gap-1.5">
              {codes.map((code) => (
                <li class="rounded border border-white/15 bg-white/10 px-2 py-0.5 text-xs font-bold font-mono font-tabular">
                  {code}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  ) : (
    <section
      id="latest-result"
      class="rounded-xl border border-[#E2E7E3] bg-white px-4 py-6 text-center text-xs text-[#5F6B66] sm:px-6"
    >
      <p class="font-bold text-[#17201D]">{t('home.sync_note')}</p>
      <p class="mt-1">
        {t('home.latest.syncing_body')}
      </p>
    </section>
  )
}
