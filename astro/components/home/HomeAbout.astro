---
/**
 * "About this site" plus the two statements a lottery results page owes its
 * readers: what was verified and when, and what the site does *not* do.
 *
 * The verification line is generated from the draw's own timestamps, so it
 * cannot claim a review that did not happen, and the notice about the statutory
 * ban on selling lottery tickets online reproduces the site's existing
 * disclaimer rather than introducing a new claim.
 */
import { BadgeCheck, AlertTriangle, ExternalLink } from 'lucide-react';
import { formatIstTimestamp } from './home-format';
import { createTranslator } from '@/lib/i18n/server';
import { withLocale } from '@/lib/i18n/client-path';
import type { Language } from '@/lib/translations';

interface Props {
  /** Locale of the page being rendered. */
  locale?: Language;
  /** Timestamp of the latest published draw, used for the "last updated" line. */
  lastUpdated?: string | Date | null;
  /** Draw number of the latest published draw, quoted in the verified line. */
  drawNumber?: string | null;
  lotteryName?: string | null;
}

const {
  locale = 'en',
  lastUpdated = null,
  drawNumber = null,
  lotteryName = null,
} = Astro.props;
const { t, tf } = createTranslator(locale);
const href = (path: string) => withLocale(path, locale);

const verifiedAt = formatIstTimestamp(lastUpdated);
const verifiedFor = [lotteryName, drawNumber].filter(Boolean).join(' ');
---

<section class="rounded-xl border border-[#E2E7E3] bg-white p-4 sm:p-5">
  <h2 class="text-base font-extrabold tracking-tight text-[#17201D]">{t('home.about.title')}</h2>

  <p class="mt-2 text-xs leading-relaxed text-[#5F6B66]">
    {t('home.about.body1')}
  </p>
  <p class="mt-2 text-xs leading-relaxed text-[#5F6B66]">
    {t('home.about.body2')}
  </p>

  <div class="mt-3 flex items-start gap-2 rounded-lg border border-[#BFE3CC] bg-[#EFF8F1] px-3 py-2.5">
    <BadgeCheck className="mt-0.5 h-4 w-4 shrink-0 text-[#16845B]" />
    <p class="text-[11px] leading-relaxed text-[#0B3B32]">
      <strong>{t('home.about.verified_label')}</strong>{' '}
      {
        tf('home.about.verified_body', {
          subject: verifiedFor ? `${verifiedFor} ` : t('home.about.latest_result'),
        })
      }
      {verifiedAt ? tf('home.about.updated', { timestamp: verifiedAt }) : ''}
    </p>
  </div>

  <div class="mt-2.5 flex items-start gap-2 rounded-lg border border-[#F2CE8A] bg-[#FFF8E8] px-3 py-2.5">
    <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0 text-[#B45309]" />
    <p class="text-[11px] leading-relaxed text-[#7C3F06]">
      <strong>{t('home.about.notice_label')}</strong> {t('home.about.notice_body')}
    </p>
  </div>

  <p class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] font-bold">
    <a href={href('/about')} class="text-[#0B5D45] hover:underline">{t('home.about.link_about')}</a>
    <a href={href('/contact')} class="text-[#0B5D45] hover:underline">{t('home.about.link_contact')}</a>
    <a href={href('/privacy-policy')} class="text-[#0B5D45] hover:underline">{t('home.about.link_privacy')}</a>
    <a
      href="https://www.lotteryagent.kerala.gov.in"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-[#0B5D45] hover:underline"
    >
      <span>{t('home.about.link_portal')}</span>
      <ExternalLink className="h-3 w-3" />
    </a>
  </p>
</section>
