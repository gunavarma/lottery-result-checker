---
/**
 * Official Kerala Lottery FAQ Accordion.
 * Built with native HTML5 <details> and <summary> tags for 100% SEO indexability
 * and 0 KB JavaScript shipping to the client.
 */
import { HOMEPAGE_FAQS } from '@/lib/home-faqs';
import { HelpCircle, ChevronDown } from 'lucide-react';
---

<div id="faqs" class="scroll-mt-24 space-y-4">
  {/* Header */}
  <div class="flex flex-wrap items-end justify-between gap-2 border-b border-[#E2E7E3] pb-2.5">
    <div>
      <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-[#17201D] sm:text-xl">
        <HelpCircle className="h-4.5 w-4.5 text-[#0B5D45]" />
        <span>Kerala Lottery Results &amp; Verification FAQs</span>
      </h2>
      <p class="mt-0.5 max-w-2xl text-xs text-[#5F6B66]">
        Clear, verified answers on daily 3:00 PM draw times, weekly schemes, prize claim protocols,
        taxes and government gazette verification.
      </p>
    </div>
    <span class="shrink-0 rounded-full bg-[#E9F3EE] px-2.5 py-0.5 text-[11px] font-bold text-[#0B5D45] font-tabular">
      {HOMEPAGE_FAQS.length} questions answered
    </span>
  </div>

  {/* Accordion Container — native <details>, so the answers are in the HTML
      whether or not the browser has JavaScript, and no accordion library ships. */}
  <div class="divide-y divide-[#E2E7E3] rounded-xl border border-[#E2E7E3] bg-white p-4 sm:p-5">
    {HOMEPAGE_FAQS.map((faq, index) => (
      <details class="group cursor-pointer py-3.5 first:pt-0 last:pb-0" open={index === 0}>
        <summary class="list-none flex items-center justify-between gap-4 text-left select-none">
          <div class="flex items-start gap-3">
            <span class="text-xs font-mono font-bold text-[#0B5D45] bg-[#E9F3EE] px-2 py-1 rounded-md shrink-0 font-tabular mt-0.5">
              Q{index + 1 < 10 ? `0${index + 1}` : index + 1}
            </span>
            <span class="text-sm sm:text-base font-extrabold text-[#17201D] group-hover:text-[#0B5D45] transition-colors leading-snug">
              {faq.question}
            </span>
          </div>
          <div class="w-7 h-7 rounded-full bg-[#F7F7F4] group-hover:bg-[#E9F3EE] flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-180">
            <ChevronDown className="w-4 h-4 text-[#5F6B66] group-hover:text-[#0B5D45]" />
          </div>
        </summary>
        <div class="mt-3.5 pl-10 pr-2 sm:pr-8 text-xs sm:text-sm text-[#5F6B66] leading-relaxed animate-fadeIn">
          <p>{faq.answer}</p>
          {faq.category && (
            <span class="inline-block mt-2.5 text-[10px] font-bold uppercase tracking-wider text-[#0B5D45] bg-[#F4F5F2] px-2 py-0.5 rounded font-tabular">
              Topic: {faq.category}
            </span>
          )}
        </div>
      </details>
    ))}
  </div>
</div>
