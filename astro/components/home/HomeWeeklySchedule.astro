---
/**
 * Official Kerala State Lottery weekly draw schedule and bumper jackpots.
 *
 * 100% server-rendered in Astro (0 KB of client JavaScript) and kept on the
 * homepage deliberately: it is the reference table visitors come back to, every
 * row links to its scheme page, and the bumper cards link to the bumper schemes.
 * The redesign only changed how it is framed — one card containing the table,
 * instead of a section header plus a dark banner plus the table.
 */
import { ArrowRight, Calendar, Award } from 'lucide-react';

const WEEKLY_DRAWS = [
  { day: 'Sunday', name: 'Samrudhi / Akshaya', code: 'SM', slug: 'samrudhi', time: '3:00 PM IST', price: '₹40', firstPrize: '₹1 Crore' },
  { day: 'Monday', name: 'Bhagya Thara', code: 'BT', slug: 'bhagya-thara', time: '3:00 PM IST', price: '₹40', firstPrize: '₹1 Crore' },
  { day: 'Tuesday', name: 'Sthree Sakthi', code: 'SS', slug: 'sthree-sakthi', time: '3:00 PM IST', price: '₹50', firstPrize: '₹1 Crore' },
  { day: 'Wednesday', name: 'Fifty-Fifty / Dhanalekshmi', code: 'FF', slug: 'fifty-fifty', time: '3:00 PM IST', price: '₹50', firstPrize: '₹1 Crore' },
  { day: 'Thursday', name: 'Karunya Plus', code: 'KN', slug: 'karunya-plus', time: '3:00 PM IST', price: '₹40', firstPrize: '₹1 Crore' },
  { day: 'Friday', name: 'Suvarna Keralam / Nirmal', code: 'SK', slug: 'suvarna-keralam', time: '3:00 PM IST', price: '₹40', firstPrize: '₹1 Crore' },
  { day: 'Saturday', name: 'Karunya', code: 'KR', slug: 'karunya', time: '3:00 PM IST', price: '₹40', firstPrize: '₹1 Crore' },
];

const BUMPERS = [
  { name: 'Thiruvonam Bumper', season: 'September (Annual Onam)', slug: 'thiruvonam-bumper', price: '₹500', firstPrize: '₹25 Crore' },
  { name: "X'mas New Year Bumper", season: 'January (New Year)', slug: 'xmas-new-year-bumper', price: '₹400', firstPrize: '₹20 Crore' },
  { name: 'Vishu Bumper', season: 'May (Summer Festival)', slug: 'vishu-bumper', price: '₹300', firstPrize: '₹12 Crore' },
  { name: 'Pooja Bumper', season: 'November (Festive)', slug: 'pooja-bumper', price: '₹300', firstPrize: '₹12 Crore' },
  { name: 'Monsoon Bumper', season: 'July (Monsoon Season)', slug: 'monsoon-bumper', price: '₹250', firstPrize: '₹10 Crore' },
  { name: 'Summer Bumper', season: 'March (Spring Season)', slug: 'summer-bumper', price: '₹250', firstPrize: '₹10 Crore' },
];

const currentDayName = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  timeZone: 'Asia/Kolkata',
}).format(new Date());
---

<div id="weekly-schedule" class="scroll-mt-24 space-y-4">
  <section class="rounded-xl border border-[#E2E7E3] bg-white p-4 sm:p-5">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 class="text-lg font-extrabold tracking-tight text-[#17201D] sm:text-xl">
          Kerala Lottery Weekly Schedule
        </h2>
        <p class="mt-0.5 max-w-2xl text-xs leading-relaxed text-[#5F6B66]">
          Kerala runs seven weekly lotteries, one fixed for each day. Each has its own series of
          draw numbers; the prize categories are similar across schemes but the amounts differ.
          Draws are held at Gorky Bhavan, Thiruvananthapuram at 3:00 PM IST.
        </p>
      </div>
      <span
        class="flex shrink-0 items-center gap-1.5 rounded-full border border-[#0B5D45]/20 bg-[#E9F3EE] px-3 py-1.5 text-[11px] font-bold text-[#0B5D45] font-tabular"
      >
        <Calendar className="h-3.5 w-3.5" />
        <span>Today in Kerala: <strong>{currentDayName}</strong></span>
      </span>
    </div>

    <p class="mt-3 text-[11px] font-semibold text-[#5F6B66]">
      Daily recurring timetable · draw at 3:00 PM IST · LOTIS verified results published by 4:00 PM IST.
    </p>

    <div class="mt-2 -mx-4 overflow-x-auto sm:-mx-5">
      <table class="w-full text-left text-xs sm:min-w-[620px] sm:text-sm">
        <caption class="sr-only">
          Kerala State Lottery weekly draw schedule: day, scheme, draw code, draw time, ticket price
          and first prize.
        </caption>
        <thead class="border-y border-[#E2E7E3] bg-[#F7F7F4] text-[11px] font-bold uppercase text-[#5F6B66]">
          <tr>
            <th scope="col" class="px-4 py-2.5 sm:px-5">Draw Day</th>
            <th scope="col" class="px-4 py-2.5 sm:px-5">Lottery Scheme</th>
            <th scope="col" class="hidden px-4 py-2.5 sm:table-cell sm:px-5">Code</th>
            <th scope="col" class="hidden px-4 py-2.5 sm:table-cell sm:px-5">Ticket Price</th>
            <th scope="col" class="px-4 py-2.5 sm:px-5">1st Prize</th>
            <th scope="col" class="hidden px-4 py-2.5 text-right sm:table-cell sm:px-5">
              Scheme
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E2E7E3]">
          {WEEKLY_DRAWS.map((draw) => {
            const isToday = draw.day.toLowerCase() === currentDayName.toLowerCase();
            return (
              <tr class={isToday ? 'bg-[#F0F7F4]' : 'hover:bg-[#FAFAF7]'}>
                <td class="px-4 py-3 sm:px-5">
                  <span class="flex items-center gap-2">
                    <span class={isToday ? 'font-extrabold text-[#0B5D45]' : 'text-[#17201D]'}>
                      {draw.day}
                    </span>
                    {isToday && (
                      <span class="rounded bg-[#0B5D45] px-1.5 py-0.5 text-[9px] font-bold text-white font-tabular">
                        TODAY
                      </span>
                    )}
                  </span>
                </td>
                <td class="px-4 py-3 font-bold text-[#17201D] sm:px-5">
                  <a
                    href={`/lottery/${draw.slug}`}
                    class="hover:text-[#0B5D45] hover:underline underline-offset-2"
                  >
                    {draw.name}
                  </a>
                </td>
                <td class="hidden px-4 py-3 font-mono text-xs font-bold text-[#5F6B66] sm:table-cell sm:px-5">
                  {draw.code}
                </td>

                <td class="hidden whitespace-nowrap px-4 py-3 font-bold text-[#17201D] font-tabular sm:table-cell sm:px-5">
                  {draw.price}
                </td>
                <td class="whitespace-nowrap px-4 py-3 font-extrabold text-[#0B5D45] font-tabular sm:px-5">
                  {draw.firstPrize}
                </td>
                <td class="hidden px-4 py-3 text-right sm:table-cell sm:px-5">
                  <a
                    href={`/lottery/${draw.slug}`}
                    aria-label={`View ${draw.name} results and schedule`}
                    class="inline-flex items-center gap-1 rounded-lg bg-[#E9F3EE] px-2.5 py-1.5 text-xs font-bold text-[#0B5D45] transition-colors hover:bg-[#D5E8DF]"
                  >
                    <span>View</span>
                    <ArrowRight className="h-3 w-3" />
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="mt-2 text-[11px] text-[#5F6B66]">
      Bumper draw dates shift slightly each year — confirm the current year&apos;s calendar on the <a
        href="/lottery-calendar"
        class="font-bold text-[#0B5D45] hover:underline">draw schedule page</a
      >.
    </p>
  </section>

  <section id="bumper-jackpots" class="scroll-mt-24 rounded-xl border border-[#E2E7E3] bg-white p-4 sm:p-5">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-[#17201D] sm:text-xl">
          <Award className="h-4.5 w-4.5 text-[#C8A45D]" />
          <span>Kerala Bumper Lotteries</span>
        </h2>
        <p class="mt-0.5 text-xs text-[#5F6B66]">
          Seasonal bumper draws with jackpots up to ₹25 Crore.
        </p>
      </div>
    </div>

    <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {BUMPERS.map((bumper) => (
        <li class="rounded-lg border border-[#E2E7E3] bg-[#FAFAF7] px-3 py-2.5">
          <a
            href={`/lottery/${bumper.slug}`}
            class="text-sm font-bold text-[#17201D] hover:text-[#0B5D45]"
          >
            {bumper.name}
          </a>
          <p class="mt-0.5 text-[11px] text-[#5F6B66]">{bumper.season}</p>
          <p class="mt-1.5 flex items-center justify-between text-[11px]">
            <span class="font-bold text-[#0B5D45] font-tabular">1st prize {bumper.firstPrize}</span>
            <span class="font-semibold text-[#5F6B66] font-tabular">Ticket {bumper.price}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>
</div>
