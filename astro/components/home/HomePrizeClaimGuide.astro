---
/**
 * Kerala lottery prize claim guide and legal rules — server-rendered, no
 * JavaScript.
 *
 * Content is unchanged from the previous version (ticket care, the ₹1 lakh
 * retailer/district-office boundary, the Directorate route above it, and the TDS
 * plus claim-deadline rules). The redesign flattened four separate cards into
 * one card with four steps, which keeps nested boxes out of the page while
 * keeping every paragraph and its internal wording.
 */
import { FileCheck, ShieldAlert, Coins, Clock, Building2, CheckCircle2 } from 'lucide-react';
import { createTranslator } from '@/lib/i18n/server';
import { withLocale } from '@/lib/i18n/client-path';
import type { Language } from '@/lib/translations';

interface Props {
  /** Locale of the page being rendered. */
  locale?: Language;
}

const { locale = 'en' } = Astro.props;
const { t } = createTranslator(locale);
const href = (path: string) => withLocale(path, locale);

// Only the structure lives here; the four pieces of each step are read from the
// dictionary so a step is translated as a whole.
const STEPS = [
  { icon: FileCheck, key: 's1', tone: 'brand' as const },
  { icon: Coins, key: 's2', tone: 'brand' as const },
  { icon: Building2, key: 's3', tone: 'brand' as const },
  { icon: Clock, key: 's4', tone: 'gold' as const },
];

const toneClasses = {
  brand: {
    icon: 'bg-[#E9F3EE] text-[#0B5D45]',
    eyebrow: 'text-[#0B5D45]',
    footer: 'text-[#0B5D45]',
  },
  gold: {
    icon: 'bg-[#FAF6ED] text-[#A66A00]',
    eyebrow: 'text-[#A66A00]',
    footer: 'text-[#A66A00]',
  },
};
---

<section id="prize-guide" class="scroll-mt-24 rounded-xl border border-[#E2E7E3] bg-white p-4 sm:p-5">
  <h2 class="text-lg font-extrabold tracking-tight text-[#17201D] sm:text-xl">
    {t('home.claim.title')}
  </h2>
  <p class="mt-1 max-w-3xl text-xs leading-relaxed text-[#5F6B66]">
    {t('home.claim.intro')}
  </p>

  <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
    {
      STEPS.map((step) => {
        const Icon = step.icon;
        const tone = toneClasses[step.tone];
        return (
          <article class="flex flex-col justify-between rounded-lg border border-[#E2E7E3] bg-[#FAFAF7] p-3.5">
            <div>
              <span class={`flex h-9 w-9 items-center justify-center rounded-lg ${tone.icon}`}>
                <Icon className="h-4.5 w-4.5" />
              </span>
              <p class={`mt-2.5 text-[10px] font-black uppercase tracking-wider font-tabular ${tone.eyebrow}`}>
                {t(`home.claim.${step.key}.eyebrow`)}
              </p>
              <h3 class="mt-0.5 text-sm font-extrabold text-[#17201D]">
                {t(`home.claim.${step.key}.title`)}
              </h3>
              <p class="mt-1 text-xs leading-relaxed text-[#5F6B66]">
                {t(`home.claim.${step.key}.body`)}
              </p>
            </div>
            <p class={`mt-3 flex items-center gap-1.5 border-t border-[#E2E7E3] pt-2.5 text-[11px] font-semibold ${tone.footer}`}>
              <CheckCircle2 className="h-3.5 w-3.5" />
              <span>{t(`home.claim.${step.key}.note`)}</span>
            </p>
          </article>
        );
      })
    }
  </div>

  <p class="mt-3 flex items-start gap-1.5 rounded-lg border border-[#F2CE8A] bg-[#FFF8E8] px-3 py-2.5 text-[11px] leading-relaxed text-[#7C3F06]">
    <ShieldAlert className="mt-0.5 h-3.5 w-3.5 shrink-0 text-[#B45309]" />
    <span>
      {t('home.claim.legal_before')}
      <a href={href('/disclaimer')} class="mx-1 font-bold text-[#B45309] underline">
        {t('home.claim.legal_link')}</a
      >
      {t('home.claim.legal_after')}
    </span>
  </p>
</section>
