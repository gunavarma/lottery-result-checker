---
import type { Language } from '@/lib/translations';
import { WHATSAPP_WELCOME_COPY } from '@/lib/whatsapp/offer-copy';
import { withLocale } from '@/lib/i18n/client-path';
import { WhatsAppLogo } from '@/components/WhatsAppLogo';

interface Props { locale?: Language }
const { locale = 'en' } = Astro.props;
const copy = WHATSAPP_WELCOME_COPY[locale] || WHATSAPP_WELCOME_COPY.en;
const ticketsHref = withLocale('/my-tickets', locale);
const homeHref = withLocale('/', locale);
---

<main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-16">
  <section class="overflow-hidden rounded-3xl border border-[#DCE7DF] bg-white shadow-sm">
    <div class="bg-[#0B3B32] px-6 py-8 text-white sm:px-10 sm:py-10">
      <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-[#F0D58E]"><WhatsAppLogo className="h-6 w-6" /> {copy.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">{copy.title}</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-white/85 sm:text-base">{copy.description}</p>
    </div>
    <div class="space-y-5 px-6 py-7 sm:px-10 sm:py-9">
      <div class="rounded-2xl border border-[#DCE7DF] bg-[#F3F8F4] p-5">
        <h2 class="text-lg font-extrabold text-[#17201D]">{copy.setupTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-[#5F6B66]">{copy.setupBody}</p>
      </div>
      <p class="text-xs leading-5 text-[#75817B]">{copy.pending}</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={ticketsHref} class="inline-flex min-h-12 flex-1 items-center justify-center rounded-xl bg-[#0B5D45] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#084936] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0B5D45]">{copy.setupCta}</a>
        <a href={homeHref} class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#D8E0DB] px-5 py-3 text-sm font-semibold text-[#34423B] transition hover:bg-[#F7F8F6] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0B5D45]">{copy.homeCta}</a>
      </div>
    </div>
  </section>
</main>
