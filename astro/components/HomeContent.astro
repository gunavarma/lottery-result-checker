---
/**
 * Homepage layout: a result portal in two columns — a wide main column that
 * answers "what are today's numbers" at the top and then explains them, and a
 * narrow sidebar holding the three tools a visitor reaches for next.
 *
 * What changed and why
 * --------------------
 * The previous version was a full-width stack of twelve sections that each
 * re-introduced the same draw from a different angle (hero terminal, finder,
 * checker, recent stream, timeline, directory, claim guide, FAQ, news, alerts,
 * trust pipeline). The most useful answer — the complete prize chart — was one
 * navigation away on a result page.
 *
 * This version renders that chart on the homepage itself. Everything above the
 * fold is server-rendered static HTML: the headline result card, the full prize
 * tiers, the series codes and the verification statement. The two islands that
 * remain are the tools that genuinely need interactivity (the ticket checker and
 * the date finder), and both hydrate on `client:visible` so they never compete
 * with the first paint.
 *
 * Nothing that was here for search engines was dropped: the H1, the explanatory
 * copy, the FAQ block, the weekly schedule, the claim guide, the news links and
 * the scheme directory all stay, and the sidebar keeps the links to
 * `/results/[scheme]/[draw]` and `/kerala-lottery-result/YYYY-MM-DD` in the HTML.
 */
import { ArrowRight } from 'lucide-react';
import HomeNextDraw from './home/HomeNextDraw.astro';
import HomeLatestResult from './home/HomeLatestResult.astro';
import HomeCheckTools from './home/HomeCheckTools.astro';
import HomePrizeChart from './home/HomePrizeChart.astro';
import HomeInfoCards from './home/HomeInfoCards.astro';
import HomeAbout from './home/HomeAbout.astro';
import HomeSidebar from './home/HomeSidebar.astro';
import HomeWeeklySchedule from './home/HomeWeeklySchedule.astro';
import HomePrizeClaimGuide from './home/HomePrizeClaimGuide.astro';
import HomeFaqSection from './home/HomeFaqSection.astro';
import { ResultFinderIsland } from '@/components/island/result-finder';
import { LotteryDirectoryListIsland } from '@/components/island/lottery-directory-list';
import { NotificationBannerIsland } from '@/components/island/notification-banner';
import { FeaturedNewsHero, NewsCard } from '@/components/NewsComponents';
import { TrustSection } from '@/components/TrustSection';
import { getHomepageData } from '@/lib/home-data';
import { getAllNews, getFeaturedNews } from '@/lib/news';
import {
  selectSchemeOptions,
  selectDirectoryItems,
  selectSchemeChoices,
} from '@/lib/home-view-models';
import { createTranslator } from '@/lib/i18n/server';
import { withLocale } from '@/lib/i18n/client-path';

interface Props {
  locale?: 'en' | 'ml' | 'ta' | 'hi';
}

const { locale = 'en' } = Astro.props;

// Every section below renders text, so each one receives the locale and looks
// its copy up in the shared dictionary. Passing it down (rather than reading it
// from a context) is what keeps the server render and the hydrated islands in
// the same language.
const { t } = createTranslator(locale);
// Internal links keep the reader in this locale instead of dropping them into
// the English tree on the next click.
const href = (path: string) => withLocale(path, locale);

// The single shared homepage loader — the same one the API uses, so the page and
// `/api/results/today` can never disagree about what today's draw is.
const data = await getHomepageData();

// `displayDraw` is the newest *published* draw with its complete prize tree: after
// 3:00 PM that is today's draw, before it it is the previous draw. Reading it
// from one field keeps the headline card, the series codes and the prize chart
// consistent with each other by construction.
const displayDraw = (data as any).displayDraw ?? null;
const isToday = Boolean(data.isTodayAvailable && displayDraw?.drawDate === data.todayDate);

const schemeOptions = selectSchemeOptions(data.popularLotteries || []);
const schemeChoices = selectSchemeChoices(data.popularLotteries || []);
const directoryItems = selectDirectoryItems(data.popularLotteries || []);

const allNews = getAllNews();
const featuredArticle = getFeaturedNews();
const secondaryNews = allNews.filter((article) => article.id !== featuredArticle.id).slice(0, 3);
---

<div class="mx-auto max-w-[1200px] px-4 pb-12 pt-5 sm:px-6">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-start">
    {/* ── Main column ───────────────────────────────────────────────────── */}
    <div class="min-w-0 flex-1 space-y-4">
      {/* Page heading. The title/meta tags are unchanged; this H1 carries the
          same query as the tag above it and is the only H1 on the page. */}
      <header class="space-y-1.5">
        <h1
          class="text-xl font-extrabold tracking-tight text-[#17201D] sm:text-2xl lg:text-[28px] lg:leading-tight"
        >
          {t('home.h1.title')}
        </h1>
        <p class="text-xs leading-relaxed text-[#5F6B66] sm:text-[13px]">
          {t('home.h1.intro')}
        </p>
      </header>

      <HomeNextDraw
        locale={locale}
        scheduledLottery={data.scheduledLottery}
        todayDate={data.todayDate}
        liveStatus={data.liveStatus}
        isTodayAvailable={data.isTodayAvailable}
        secondsUntilDraw={data.secondsUntilDraw}
      />

      <HomeLatestResult locale={locale} draw={displayDraw} isToday={isToday} />

      <HomeCheckTools locale={locale} lotteries={schemeChoices} />

      <HomePrizeChart locale={locale} draw={displayDraw} />

      {/* Historical lookup: the date/scheme finder, unchanged from before but
          now labelled and framed as what it is. */}
      <section id="find-result" class="scroll-mt-24 space-y-3">
        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-[#E2E7E3] pb-2.5">
          <div>
            <h2 class="text-lg font-extrabold tracking-tight text-[#17201D] sm:text-xl">
              {t('home.find.title')}
            </h2>
            <p class="mt-0.5 text-xs text-[#5F6B66]">
              {t('home.find.intro')}
            </p>
          </div>
          <div class="flex items-center gap-3 text-[11px] font-bold">
            <a href={href('/previous-results')} class="text-[#0B5D45] hover:underline">
              {t('home.find.previous')}
            </a>
            <a href={href('/kerala-lottery-results')} class="text-[#0B5D45] hover:underline">
              {t('home.find.archive')}
            </a>
          </div>
        </div>
        <ResultFinderIsland client:visible locale={locale} lotteries={schemeOptions} />
      </section>

      <HomeInfoCards locale={locale} />

      <HomeWeeklySchedule locale={locale} />

      {/* Scheme directory — the same island as before, kept for the ticket price
          and top-prize columns and for its links to every scheme page. */}
      <section id="lotteries" class="scroll-mt-24 space-y-3">
        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-[#E2E7E3] pb-2.5">
          <div>
            <h2 class="text-lg font-extrabold tracking-tight text-[#17201D] sm:text-xl">
              {t('home.active_schemes')}
            </h2>
            <p class="mt-0.5 text-xs text-[#5F6B66]">
              {t('home.schemes.intro')}
            </p>
          </div>
          <a
            href={href('/lotteries')}
            class="inline-flex items-center gap-1 text-[11px] font-bold text-[#0B5D45] hover:underline"
          >
            <span>{t('home.schemes.all')}</span>
            <ArrowRight className="h-3 w-3" />
          </a>
        </div>
        <LotteryDirectoryListIsland client:visible locale={locale} lotteries={directoryItems} />
      </section>

      <HomePrizeClaimGuide locale={locale} />

      <HomeAbout
        locale={locale}
        lastUpdated={displayDraw?.verifiedAt ?? displayDraw?.updatedAt ?? null}
        drawNumber={displayDraw?.drawNumber ?? null}
        lotteryName={displayDraw?.lottery?.name ?? null}
      />

      <HomeFaqSection locale={locale} />

      {/* Editorial news. Kept where it was in the old page order — it is the
          only block that links into /news, so removing it would orphan that
          section of the site. */}
      <section id="news" class="scroll-mt-24 space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-[#E2E7E3] pb-2.5">
          <div>
            <h2 class="text-lg font-extrabold tracking-tight text-[#17201D] sm:text-xl">
              {t('home.latest_news')}
            </h2>
            <p class="mt-0.5 text-xs text-[#5F6B66]">
              {t('home.news.intro')}
            </p>
          </div>
          <a
            href={href('/news')}
            class="inline-flex items-center gap-1 text-[11px] font-bold text-[#0B5D45] hover:underline"
          >
            <span>{t('home.news.all')}</span>
            <ArrowRight className="h-3 w-3" />
          </a>
        </div>
        <FeaturedNewsHero article={featuredArticle} locale={locale} />
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {secondaryNews.map((article) => <NewsCard article={article} locale={locale} />)}
        </div>
      </section>

      <TrustSection locale={locale} />

      <NotificationBannerIsland client:visible locale={locale} />
    </div>

    {/* ── Sidebar ───────────────────────────────────────────────────────── */}
    <div class="w-full shrink-0 lg:w-[320px]">
      <HomeSidebar
        locale={locale}
        recentDraws={data.latestDraws || []}
        lotteries={data.popularLotteries || []}
      />
    </div>
  </div>
</div>
