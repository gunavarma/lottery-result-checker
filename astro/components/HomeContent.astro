---
/**
 * Homepage content, ported from `components/home/HomeContent.tsx`.
 *
 * The Next.js version was a React *Server* Component: an `async` function that
 * awaited the database and returned JSX. Astro has no async components, so the
 * data fetching moves into the frontmatter — which is exactly where Astro wants
 * it — and this file keeps the original section order and markup.
 *
 * The split follows one rule: anything that owns state, effects or a query hook
 * is an island (`client:load`); anything purely presentational is rendered by
 * Astro inline and ships no JavaScript at all. That is why `TrustSection` and
 * the news cards appear bare while `TicketChecker` and `UpcomingDrawsTimeline`
 * are islands.
 */
import { HeroTodayCardIsland } from '@/components/island/hero-today-card';
import { ResultFinderIsland } from '@/components/island/result-finder';
import { RecentResultsStreamIsland } from '@/components/island/recent-results-stream';
import { TicketCheckerIsland } from '@/components/island/ticket-checker';
import { UpcomingDrawsTimelineIsland } from '@/components/island/upcoming-draws-timeline';
import { LotteryDirectoryListIsland } from '@/components/island/lottery-directory-list';
import { NotificationBannerIsland } from '@/components/island/notification-banner';
import { FeaturedNewsHero, NewsCard } from '@/components/NewsComponents';
import { TrustSection } from '@/components/TrustSection';
import HomeQuickNav from './home/HomeQuickNav.astro';
import HomeWeeklySchedule from './home/HomeWeeklySchedule.astro';
import HomePrizeClaimGuide from './home/HomePrizeClaimGuide.astro';
import HomeFaqSection from './home/HomeFaqSection.astro';
import { ArrowRight } from 'lucide-react';
import { getHomepageData } from '@/lib/home-data';
import { getAllNews, getFeaturedNews } from '@/lib/news';
import {
  selectHeroData,
  selectRecentDrawItems,
  selectSchemeOptions,
  selectDirectoryItems,
  selectSchemeChoices,
} from '@/lib/home-view-models';

interface Props {
  locale?: 'en' | 'ml' | 'ta' | 'hi';
}

const { locale = 'en' } = Astro.props;

const data = await getHomepageData();

// Islands serialise their props into the HTML, so each one is handed only the
// slice it renders. Passing `data` wholesale made the production document
// 529 KB (423 KB of it island props) and dominated FCP/LCP. See
// `lib/home-view-models.ts` for the field-by-field reasoning.
const heroData = selectHeroData(data);
const recentDrawItems = selectRecentDrawItems(data.latestDraws || []);
const schemeOptions = selectSchemeOptions(data.popularLotteries || []);
const directoryItems = selectDirectoryItems(data.popularLotteries || []);
const schemeChoices = selectSchemeChoices(data.popularLotteries || []);

const allNews = getAllNews();
const featuredArticle = getFeaturedNews();
const secondaryNews = allNews.filter((a) => a.id !== featuredArticle.id).slice(0, 3);
---

<div class="space-y-10 sm:space-y-14 pb-16">
  {/* 1. Hero Result Terminal (Immediate 1-second Answer) */}
  <section id="today-result" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 space-y-6 scroll-mt-24">
    {/* client:idle because the full hero HTML is already server-rendered with
        initialData — hydration only adds the live-refresh and countdown timer,
        neither of which is needed during FCP/LCP. */}
    <HeroTodayCardIsland client:idle locale={locale} initialData={heroData} />
    <ResultFinderIsland client:visible locale={locale} lotteries={schemeOptions} />
  </section>

  {/* 2. Quick-Jump Navigation & Authority Bar */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <HomeQuickNav />
  </section>

  {/* 3. Ticket Verification Terminal */}
  <section id="ticket-checker" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
    <TicketCheckerIsland client:visible locale={locale} lotteries={schemeChoices} />
  </section>

  {/* 4. Scannable Recent Results Stream (Table / List Hybrid) */}
  <section id="recent-results" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 scroll-mt-24">
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#E2E7E3] pb-3"
    >
      <div>
        <span
          class="text-[11px] font-bold text-[#0B5D45] uppercase tracking-wider block font-tabular"
        >
          Chronological Stream
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#17201D] tracking-tight">
          Recent Official Results
        </h2>
      </div>
      <a
        href="/results"
        class="inline-flex items-center gap-1 text-xs font-bold text-[#0B5D45] hover:text-[#084835] transition-colors shrink-0"
      >
        <span>View All Results</span>
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>

    {/* Everything below the hero is off the first screen, so it hydrates when
        it scrolls into view. The markup is still server-rendered (no CLS, no
        SEO cost); only the hydration and the island's JavaScript are deferred. */}
    <RecentResultsStreamIsland client:visible locale={locale} draws={recentDrawItems} />
  </section>

  {/* 5. Upcoming Draws Timeline */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <UpcomingDrawsTimelineIsland client:visible locale={locale} />
  </section>

  {/* 6. Official Kerala Lottery Weekly Timetable & Bumper Matrix */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <HomeWeeklySchedule />
  </section>

  {/* 7. Active Kerala Schemes Directory */}
  <section id="lotteries" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 scroll-mt-24">
    <div class="flex items-center justify-between border-b border-[#E2E7E3] pb-3">
      <div>
        <span
          class="text-[11px] font-bold text-[#0B5D45] uppercase tracking-wider block font-tabular"
        >
          Weekly &amp; Bumper Schemes
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#17201D] tracking-tight">
          Active Kerala Lottery Schemes Directory
        </h2>
      </div>
      <a
        href="/lotteries"
        class="text-xs font-bold text-[#0B5D45] hover:text-[#084835] inline-flex items-center gap-1 transition-colors"
      >
        <span>All Schemes</span>
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>

    <LotteryDirectoryListIsland client:visible locale={locale} lotteries={directoryItems} />
  </section>

  {/* 8. Official Prize Claim Guidelines & Legal Rules */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <HomePrizeClaimGuide />
  </section>

  {/* 9. SEO Frequently Asked Questions (FAQ) */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <HomeFaqSection />
  </section>

  {/* 10. Editorial Gazette News & Analysis */}
  <section id="news" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 scroll-mt-24">
    <div class="flex items-center justify-between border-b border-[#E2E7E3] pb-3">
      <div>
        <span
          class="text-[11px] font-bold text-[#0B5D45] uppercase tracking-wider block font-tabular"
        >
          Gazette Releases
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#17201D] tracking-tight">
          Latest Lottery News &amp; Reports
        </h2>
      </div>
      <a
        href="/news"
        class="text-xs font-bold text-[#0B5D45] hover:text-[#084835] inline-flex items-center gap-1 transition-colors"
      >
        <span>View All News</span>
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>

    {/* Presentational only — rendered inline, no hydration, no JS shipped. */}
    <div class="space-y-6">
      <FeaturedNewsHero article={featuredArticle} />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* No `key`: Astro renders each React component as its own instance, so
            there is no list for React to reconcile. */}
        {secondaryNews.map((article) => <NewsCard article={article} />)}
      </div>
    </div>
  </section>

  {/* 11. Notification Opt-in Prompt */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <NotificationBannerIsland client:visible locale={locale} />
  </section>

  {/* 12. Trust & Verification 4-Step Pipeline */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <TrustSection />
  </section>
</div>
