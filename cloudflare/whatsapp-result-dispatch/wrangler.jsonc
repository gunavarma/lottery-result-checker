{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "keraladraws-whatsapp-result-dispatch",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "vars": {
    "APP_URL": "https://www.keraladraws.com",
    "WHATSAPP_SENDING_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}
